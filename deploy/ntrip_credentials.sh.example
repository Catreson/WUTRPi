export NTRIP_USER=your_asgeupos_username
export NTRIP_PASS=your_asgeupos_password

# ASG-EUPOS mountpoint to pull RTCM corrections from - pick the one closest to
# wherever you're testing/racing (RADM_RTCM_3_2 = Radom). Check the ASG-EUPOS
# sourcetable for the full list of mountpoints.
export NTRIP_MOUNTPOINT=RADM_RTCM_3_2
